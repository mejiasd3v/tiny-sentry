# Run `bun run setup` to generate .env with random credentials.
ADMIN_TOKEN=replace-with-at-least-32-random-characters
SENTRY_PROJECTS={"1":"replace-with-a-random-public-key"}
DB_PATH=./data/tiny-sentry.sqlite
PORT=3000
# RETENTION_DAYS=14
# MAX_EVENTS=10000
# MAX_DB_MB=256
# MAX_REQUEST_BYTES=1048576
# MAX_EVENT_BYTES=131072
# RATE_LIMIT_PER_MINUTE=120
# WEBHOOK_URL=https://your-endpoint.example/errors
# WEBHOOK_TOKEN=optional-bearer-token
# Optional durable integrations. Credentials stay in separate server variables.
# See docs/integrations.md for all providers and custom TS plugins.
# INTEGRATIONS='[{"id":"github-after-ten","type":"github","projects":["1"],"trigger":{"type":"threshold","count":10},"options":{"repository":"owner/repo","tokenEnv":"GITHUB_ISSUES_TOKEN"}}]'
# GITHUB_ISSUES_TOKEN=your-repository-issues-token
# MAX_DELIVERIES=1000
# INTEGRATIONS_MODULE=./src/custom-integrations.ts
# TINY_SENTRY_URL=https://tiny-sentry.example.com
